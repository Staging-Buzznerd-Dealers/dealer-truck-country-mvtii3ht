{
  "version": 1,
  "id": "social-icons",
  "label": "Social icons",
  "description": "A row of circular social links. One row per network, edited as a list.",
  "category": "content",
  "origin": "ai",
  "props": [
    {
      "key": "heading",
      "type": "text",
      "label": "Heading",
      "default": "Follow us"
    },
    {
      "key": "links",
      "type": "list",
      "label": "Networks",
      "fields": [
        {
          "key": "name",
          "type": "text",
          "label": "Network"
        },
        {
          "key": "icon",
          "type": "image",
          "label": "Icon"
        },
        {
          "key": "url",
          "type": "url",
          "label": "Profile URL"
        }
      ]
    }
  ],
  "html": "<div class=\"tc-social\">\n  {{#if heading}}<p class=\"tc-social__h\">{{heading}}</p>{{/if}}\n  <ul class=\"tc-social__list\">\n    {{#each links}}\n    <li><a class=\"tc-social__a\" href=\"{{link url}}\" aria-label=\"{{name}}\" data-bz-el=\"link\" data-bz-intent=\"social-profile\">{{img icon}}</a></li>\n    {{/each}}\n  </ul>\n</div>",
  "css": ".tc-social__h{font-family:var(--font-heading);color:#fff;font-size:13px;letter-spacing:.08em;text-transform:uppercase;margin:0 0 18px}\n.tc-social__list{display:flex;gap:14px;flex-wrap:wrap;list-style:none;margin:0;padding:0}\n.tc-social__a{width:34px;height:34px;border-radius:50%;border:1px solid rgba(255,255,255,.25);display:flex;align-items:center;justify-content:center;transition:border-color .2s ease,background .2s ease}\n.tc-social__a:hover{border-color:#fff;background:rgba(255,255,255,.08)}\n.tc-social__a img{width:16px;height:16px;filter:brightness(0) invert(1)}"
}
