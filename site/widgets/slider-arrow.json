{
  "version": 1,
  "id": "slider-arrow",
  "label": "Slider arrow",
  "category": "content",
  "origin": "ai",
  "description": "A round previous/next control. Mark the node that places it part: prev or next.",
  "props": [
    {
      "key": "glyph",
      "type": "select",
      "label": "Direction",
      "options": [
        {
          "value": "\u2039",
          "label": "Previous"
        },
        {
          "value": "\u203a",
          "label": "Next"
        }
      ],
      "default": "\u2039"
    },
    {
      "key": "label",
      "type": "text",
      "label": "Accessible name",
      "default": "Previous slide"
    },
    {
      "key": "tone",
      "type": "select",
      "label": "Tone",
      "options": [
        {
          "value": "light",
          "label": "On a photo"
        },
        {
          "value": "dark",
          "label": "On a page"
        }
      ],
      "default": "light"
    }
  ],
  "html": "<button class=\"tc-arrow tc-arrow--{{tone}}\" type=\"button\" data-bz-el=\"control\" aria-label=\"{{label}}\"><span aria-hidden=\"true\">{{glyph}}</span></button>",
  "css": ".tc-arrow{width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:20px;line-height:1;cursor:pointer;padding:0}\n.tc-arrow--light{background:rgba(0,0,0,.35);border:1.5px solid rgba(255,255,255,.6);color:#fff}\n.tc-arrow--light:hover{background:rgba(0,0,0,.55);border-color:#fff}\n.tc-arrow--dark{background:#fff;border:1px solid var(--line);box-shadow:0 8px 20px -8px rgba(0,0,0,.3);color:var(--ink)}\n.tc-arrow--dark:hover{border-color:var(--muted)}\n.tc-arrow[disabled]{opacity:.35;cursor:default}"
}
