                {
                  "id": "s3t17",
                  "type": "text",
                  "props": {
                    "text": "A continuous improvement coordinator (CIC) is designated to all our Elite Support dealerships. CICs assist our dealerships in solving opportunities for improvement, instill accountability, and eliminate waste. CICs are accountable for all 70+ criteria items across all aspects of the dealership.",
                    "width": "full"
                  },
                  "styles": {
                    "base": {
