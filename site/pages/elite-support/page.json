                  "borderTopWidth": "4",
                  "borderRightWidth": "1",
                  "borderBottomWidth": "1",
                  "borderLeftWidth": "1"
                }
              },
              "children": [
                {
                  "id": "s3h7",
                  "type": "heading",
                  "props": {
                    "text": "Fast Turnaround",
                    "headingLevel": 2
                  },
                  "styles": {
                    "base": {
                      "paddingTop": 0,
                      "paddingBottom": 0
                    }
                  }
                },
                {
                  "id": "s3t8",
                  "type": "text",
                  "props": {
                    "text": "Uptime is a major factor in determining your Real Cost of Ownership. A single unscheduled day of downtime could cost upwards of $1,000, so we are focused on maximizing your Uptime. Our technicians work in well- organized, safe, and efficient service bays. End Result = your unit back on the road faster!",
                    "width": "full"
                  },
                  "styles": {
                    "base": {
                      "paddingTop": 0,
                      "paddingBottom": 0
                    }
                  }
                }
              ]
            },
            {
              "id": "s3c9",
              "type": "column",
              "props": {
                "span": 1
              },
              "styles": {
                "base": {
                  "background": "#ffffff",
                  "borderTopWidth": "4",
                  "borderRightWidth": "1",
                  "borderBottomWidth": "1",
                  "borderLeftWidth": "1"
                }
              },
              "children": [
                {
                  "id": "s3h10",
                  "type": "heading",
                  "props": {
                    "text": "Team Expertise",
                    "headingLevel": 2
                  },
                  "styles": {
                    "base": {
                      "paddingTop": 0,
                      "paddingBottom": 0
                    }
                  }
                },
                {
                  "id": "s3t11",
                  "type": "text",
                  "props": {
                    "text": "Elite Support certified dealers are staffed by experienced Service and Parts employees and factory- trained Technicians. Every repair is quality checked before leaving the service bay- reducing comebacks and giving you the fast turnaround you need to keep the wheels turning.",
                    "width": "full"
                  },
                  "styles": {
                    "base": {
                      "paddingTop": 0,
                      "paddingBottom": 0
                    }
                  }
                }
              ]
