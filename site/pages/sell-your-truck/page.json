        "sectionId": "numbered-cards",
        "values": {
          "anchorId": "process",
          "eyebrow": "The process",
          "heading": "Selling your truck in four steps",
          "items": [
            {
              "num": "01",
              "title": "Submit your details",
              "body": "Share your truck’s year, make, model, mileage and condition. Add photos if you have them."
            },
            {
              "num": "02",
              "title": "We review your truck",
              "body": "A team member looks over the information and may ask for more details or an inspection."
            },
            {
              "num": "03",
              "title": "Receive an offer",
              "body": "We contact you with next steps, and can discuss a trade-in toward another truck."
            },
            {
              "num": "04",
              "title": "Complete the sale",
              "body": "Finalize the paperwork with your dealership contact."
            }
          ]
        }
      }
