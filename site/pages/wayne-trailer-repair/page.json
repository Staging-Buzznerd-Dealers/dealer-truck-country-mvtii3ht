    {
      "id": "s5-band",
      "type": "sharedSection",
      "props": {
        "sectionId": "wayne-trailer-repair-s5",
        "values": {
          "items": [
            {
              "f0": "14 Service Bays",
              "f1": "Our location has ample space for your semi-truck trailer and our technicians to perform maintenance, repairs, and inspections."
            },
            {
              "f0": "Auto Modifications - Steel Reinforcement",
              "f1": "Our team can complete auto modifications including steel reinforcement, which maximizes safety."
            },
            {
              "f0": "Autocar Parts, Sales, and Service",
              "f1": "Our dealership puts a main focus on Autocar parts, sales, and service."
            },
            {
              "f0": "Bogie Repairs and Replacements",
              "f1": "The maintenance or replacement of the axle assemble."
            },
            {
              "f0": "Box Repairs and Installation",
              "f1": "Our team will repair or install a tool box for additional storage space."
            },
            {
              "f0": "Brake and System Repair and Installation",
              "f1": "Our team will inspect your trailer’s braking system for maintenance, repairs, and replacements."
            },
            {
              "f0": "Custom Fabrications and Modifications",
              "f1": "Our technicians can alter and modify your semi-truck to better suit your needs."
            },
            {
              "f0": "Door Conversion, Repair, Modification, and Installation",
              "f1": "Our team of expert techs will inspect your trailer doors."
            },
            {
              "f0": "DOT Inspections",
              "f1": "Our technicians will perform a series of tests to ensure you are safe and comply with federal safety regulations."
            },
            {
              "f0": "Floor Repair and Installation",
              "f1": "Repairing damaged floorboards within a trailer or installing new floorboards."
            },
            {
              "f0": "General Repairs - All Makes and Models",
              "f1": "Our experienced technicians will diagnose and fix all general trailer components."
            },
            {
              "f0": "Lift Gate and Lift Pad Installation",
              "f1": "We will install your lift gates and lift pads."
            },
            {
              "f0": "Patching Walls and Roofs",
              "f1": "The well being of your trailer is important. Our techs will identify damaged material and repair the area."
            },
            {
              "f0": "PSI System Installation",
              "f1": "The installation of a Pressure Systems International system, which maintains tire pressure."
            },
            {
              "f0": "Replacing Partial and up to Full Roofs",
              "f1": "Our experienced techs will inspect the trailer roof for damaged material. They will repair or replace the roof of the semi-trailer."
            },
            {
              "f0": "Scale Installation",
              "f1": "Our experienced team attaches specialized sensors to measure air pressure which is converted into weight readings. This allows the driver to monitor the weight distribution on each axle of the trailer."
            },
            {
              "f0": "Skirt, Wing, and Other Aerodynamic Device Installation",
              "f1": "Our team will install skirt, wings and other aerodynamic devices. These components reduce air drag and save fuel."
            },
            {
              "f0": "Wabash and Landoll Warranty Work",
              "f1": "We offer repairs on your trailer that are covered by Wabash and MAC."
            }
          ]
        }
      }
