                {
                  "id": "s3h3",
                  "type": "heading",
                  "props": {
                    "text": "Truck Country Technical Institute Certified Diesel Technician Employee Program",
                    "headingLevel": 2
                  },
                  "styles": {
                    "base": {
                      "paddingTop": 0,
                      "paddingBottom": 0
                    }
                  }
                },
                {
                  "id": "s3t4",
                  "type": "text",
                  "props": {
                    "text": "This 2 year technical curriculum will cover everything needed to launch a successful career by combining a minimum of 27 modules of classroom instruction and hands-on exercises with on-the-job training.",
                    "width": "full"
                  },
                  "styles": {
                    "base": {
                      "paddingTop": 0,
                      "paddingBottom": 0
                    }
                  }
                },
                {
                  "id": "s3t5",
                  "type": "text",
                  "props": {
                    "text": "The Truck Country Technical Institute provides a small classroom environment (classes are limited to 10–12 students) that allows for plenty of one-on-one instruction.",
                    "width": "full"
                  },
                  "styles": {
                    "base": {
                      "paddingTop": 0,
                      "paddingBottom": 0
                    }
                  }
                },
                {
                  "id": "s3t6",
                  "type": "text",
                  "props": {
                    "text": "Students will attend all courses at the Truck Country Training Center in Dubuque, Iowa, then return to their home dealerships, located throughout Iowa and Wisconsin, to put what they’ve learned in the classroom into practice.",
                    "width": "full"
                  },
                  "styles": {
                    "base": {
                      "paddingTop": 0,
                      "paddingBottom": 0
                    }
                  }
                },
                {
                  "id": "s3t7",
                  "type": "text",
                  "props": {
                    "text": "Upon graduation, students earn the recognition of <strong>Freightliner Certified Technician</strong> and receive a nationally recognized <strong>Apprenticeship Certification.</strong>",
                    "width": "full"
                  },
                  "styles": {
                    "base": {
                      "paddingTop": 0,
                      "paddingBottom": 0
                    }
                  }
                }
              ]
