              "children": [
                {
                  "id": "about-head",
                  "type": "heading",
                  "props": {
                    "text": "FAMILY-OWNED. FREIGHTLINER STRONG. SINCE 1958.",
                    "eyebrow": "About Truck Country",
                    "headingLevel": 2
                  }
                },
                {
                  "id": "about-p1",
                  "type": "text",
                  "props": {
                    "text": "Truck Country\u00ae / Stoops Freightliner-Western Star is one of the largest Freightliner dealership group in the U.S. today, serving customers at locations in Illinois, Iowa, Indiana, Ohio, Michigan, and Wisconsin. For nearly 60 years, Truck Country/Stoops has offered new and used medium and heavy duty trucks, expert service, an extensive parts inventory, and convenient financing options. Our brands include Freightliner, Western Star, Wabash and Autocar.",
                    "width": "full"
                  }
                },
                {
                  "id": "about-p2",
                  "type": "text",
                  "props": {
                    "text": "Truck Country\u00ae / Stoops Freightliner-Western Star is part of McCoy Group, Inc., which was founded in 1958 by Robert McCoy in Shullsburg, WI. Today the company is still family-owned and is operated under the leadership of the McCoy family.",
                    "width": "full"
                  }
                }
              ]
            },
            {
              "id": "about-media",
              "type": "column",
              "props": {
                "span": 6,
                "align": "center"
              },
              "children": [
                {
                  "id": "about-photo",
                  "type": "image",
                  "props": {
                    "image": {
                      "src": "/img/about.jpg",
                      "alt": "A Truck Country dealership",
                      "width": 1400,
                      "height": 401
                    },
                    "width": "full"
                  }
                },
                {
                  "id": "about-cta",
                  "type": "buttons",
                  "props": {
                    "items": [
                      {
                        "ctaId": "about-us"
                      }
                    ],
                    "align": "center"
                  },
                  "styles": {
                    "base": {
                      "marginTop": 24
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
