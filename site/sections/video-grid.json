{
  "version": 2,
  "id": "video-grid",
  "name": "Video grid",
  "description": "A grid of videos, each in a white card with its title underneath. A row with no link shows the placeholder note instead.",
  "css": "[data-bz-node=\"vg-head\"] h2{font-family:var(--font-heading);font-weight:700;font-size:clamp(28px,4vw,42px);line-height:1.1;text-transform:uppercase;letter-spacing:0}\n[data-bz-node=\"vg-head\"] h2{margin:0 0 40px}\n[data-bz-node=\"vg-grid\"]>.bz-col{grid-column:auto}\n[data-bz-node=\"vg-grid\"] .bz-block,[data-bz-node=\"vg-grid\"] .bz-container,[data-bz-node=\"vg-wide\"] .bz-block,[data-bz-node=\"vg-wide\"] .bz-container{padding:0}\n[data-bz-section=\"video-grid\"] .bz-video--embed{position:relative;padding-top:56.25%}\n[data-bz-section=\"video-grid\"] .bz-video--embed iframe{position:absolute;inset:0;width:100%;height:100%;border:0}\n[data-bz-section=\"video-grid\"] .bz-photo--empty{display:none}\n[data-bz-section=\"video-grid\"] h3{font-family:var(--font-heading);font-weight:600;font-size:18px;line-height:1.3;letter-spacing:.04em;text-transform:uppercase;margin:14px 0 0}\n[data-bz-section=\"video-grid\"] .bz-text p{margin:0;display:flex;align-items:center;justify-content:center;min-height:200px;background:#EDEBE3;border:1px dashed #8F8F8F;color:#54565C;font-size:14px}",
  "props": [
    {
      "key": "heading",
      "type": "text",
      "label": "Heading",
      "default": ""
    },
    {
      "key": "items",
      "type": "list",
      "label": "Videos",
      "fields": [
        {
          "key": "title",
          "type": "text",
          "label": "Title"
        },
        {
          "key": "url",
          "type": "url",
          "label": "Video link"
        },
        {
          "key": "note",
          "type": "text",
          "label": "Placeholder note"
        }
      ]
    },
    {
      "key": "featuredTitle",
      "type": "text",
      "label": "Full-width video title",
      "default": ""
    },
    {
      "key": "featuredUrl",
      "type": "url",
      "label": "Full-width video link",
      "default": ""
    },
    {
      "key": "featuredNote",
      "type": "text",
      "label": "Full-width placeholder note",
      "default": ""
    }
  ],
  "nodes": [
    {
      "id": "vg",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 0,
        "anchor": "videos"
      },
      "styles": {
        "base": {
          "paddingTop": 100,
          "paddingBottom": 100
        },
        "tablet": {
          "paddingTop": 72,
          "paddingBottom": 72
        },
        "mobile": {
          "paddingTop": 56,
          "paddingBottom": 56
        }
      },
      "children": [
        {
          "id": "vg-head-row",
          "type": "row",
          "props": {
            "gap": 0
          },
          "children": [
            {
              "id": "vg-head-col",
              "type": "column",
              "props": {
                "span": 12
              },
              "children": [
                {
                  "id": "vg-head",
                  "type": "heading",
                  "props": {
                    "text": "{{heading}}",
                    "headingLevel": 2
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "vg-grid",
          "type": "row",
          "props": {
            "gap": 5,
            "align": "stretch",
            "stackOn": "never"
          },
          "styles": {
            "base": {
              "gridColumns": "1fr 1fr",
              "gap": 24
            },
            "mobile": {
              "gridColumns": "1fr"
            }
          },
          "children": [
            {
              "id": "vg-card",
              "type": "column",
              "props": {
                "span": 12,
                "repeat": "items"
              },
              "styles": {
                "base": {
                  "background": "card",
                  "borderWidth": 1,
                  "borderStyle": "solid",
                  "borderColor": "#EDEBE3",
                  "paddingTop": 20,
                  "paddingRight": 20,
                  "paddingBottom": 20,
                  "paddingLeft": 20
                }
              },
              "children": [
                {
                  "id": "vg-video",
                  "type": "video",
                  "props": {
                    "video": {
                      "src": "{{url}}",
                      "title": "{{title}}"
                    },
                    "width": "full"
                  }
                },
                {
                  "id": "vg-note",
                  "type": "text",
                  "props": {
                    "text": "{{note}}",
                    "width": "full"
                  }
                },
                {
                  "id": "vg-title",
                  "type": "heading",
                  "props": {
                    "text": "{{title}}",
                    "headingLevel": 3
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "vg-wide-row",
          "type": "row",
          "props": {
            "gap": 0
          },
          "styles": {
            "base": {
              "marginTop": 24
            }
          },
          "children": [
            {
              "id": "vg-wide",
              "type": "column",
              "props": {
                "span": 12
              },
              "styles": {
                "base": {
                  "background": "card",
                  "borderWidth": 1,
                  "borderStyle": "solid",
                  "borderColor": "#EDEBE3",
                  "paddingTop": 20,
                  "paddingRight": 20,
                  "paddingBottom": 20,
                  "paddingLeft": 20
                }
              },
              "children": [
                {
                  "id": "vg-wide-video",
                  "type": "video",
                  "props": {
                    "video": {
                      "src": "{{featuredUrl}}",
                      "title": "{{featuredTitle}}"
                    },
                    "width": "full"
                  }
                },
                {
                  "id": "vg-wide-note",
                  "type": "text",
                  "props": {
                    "text": "{{featuredNote}}",
                    "width": "full"
                  }
                },
                {
                  "id": "vg-wide-title",
                  "type": "heading",
                  "props": {
                    "text": "{{featuredTitle}}",
                    "headingLevel": 3
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
