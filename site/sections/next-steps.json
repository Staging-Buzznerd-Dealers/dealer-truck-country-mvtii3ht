{
  "version": 2,
  "id": "next-steps",
  "name": "Next steps",
  "description": "A row of link cards closing an inner page. One card per list row.",
  "css": "[data-bz-node=\"ns-head\"] h2{font-family:var(--font-heading);font-weight:700;font-size:clamp(28px,4vw,42px);line-height:1.1;text-transform:uppercase;letter-spacing:0}\n[data-bz-node=\"ns-head\"] h2{margin:0 0 32px}\n[data-bz-node=\"ns-grid\"]>.bz-col{grid-column:auto;transition:border-color .2s ease}\n[data-bz-node=\"ns-grid\"]>.bz-col:hover{border-color:#C41230}\n[data-bz-node=\"ns-grid\"] .bz-block,[data-bz-node=\"ns-grid\"] .bz-container{padding:0}\n[data-bz-node=\"ns-grid\"] h3{font-family:var(--font-heading);font-weight:600;font-size:18px;line-height:1.3;letter-spacing:.04em;text-transform:uppercase;margin:0 0 8px}\n[data-bz-node=\"ns-grid\"] .bz-text p{margin:0 0 14px;color:#54565C;font-size:16px}\n[data-bz-node=\"ns-grid\"] .bz-btn--link{padding:0;font-family:var(--font-body);font-size:15px;font-weight:600;letter-spacing:0;text-transform:none;color:#C41230;text-decoration:underline}\n[data-bz-node=\"ns-grid\"] .bz-btn--link:hover{color:#8f0d21}",
  "props": [
    {
      "key": "heading",
      "type": "text",
      "label": "Heading",
      "default": "Next steps"
    },
    {
      "key": "items",
      "type": "list",
      "label": "Cards",
      "fields": [
        {
          "key": "title",
          "type": "text",
          "label": "Title"
        },
        {
          "key": "body",
          "type": "text",
          "label": "Text"
        },
        {
          "key": "linkLabel",
          "type": "text",
          "label": "Link label"
        },
        {
          "key": "url",
          "type": "url",
          "label": "Links to"
        }
      ]
    }
  ],
  "nodes": [
    {
      "id": "ns",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 0
      },
      "styles": {
        "base": {
          "paddingTop": 100,
          "paddingBottom": 100
        },
        "tablet": {
          "paddingTop": 72,
          "paddingBottom": 72
        },
        "mobile": {
          "paddingTop": 56,
          "paddingBottom": 56
        }
      },
      "children": [
        {
          "id": "ns-head-row",
          "type": "row",
          "props": {
            "gap": 0
          },
          "children": [
            {
              "id": "ns-head-col",
              "type": "column",
              "props": {
                "span": 12
              },
              "children": [
                {
                  "id": "ns-head",
                  "type": "heading",
                  "props": {
                    "text": "{{heading}}",
                    "headingLevel": 2
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "ns-grid",
          "type": "row",
          "props": {
            "gap": 5,
            "align": "stretch",
            "stackOn": "never"
          },
          "styles": {
            "base": {
              "gridColumns": "1fr 1fr 1fr 1fr"
            },
            "tablet": {
              "gridColumns": "1fr 1fr"
            },
            "mobile": {
              "gridColumns": "1fr"
            }
          },
          "children": [
            {
              "id": "ns-card",
              "type": "column",
              "props": {
                "span": 12,
                "repeat": "items"
              },
              "styles": {
                "base": {
                  "background": "card",
                  "borderWidth": 1,
                  "borderStyle": "solid",
                  "borderColor": "#EDEBE3",
                  "paddingTop": 28,
                  "paddingRight": 28,
                  "paddingBottom": 28,
                  "paddingLeft": 28
                }
              },
              "children": [
                {
                  "id": "ns-title",
                  "type": "heading",
                  "props": {
                    "text": "{{title}}",
                    "headingLevel": 3
                  }
                },
                {
                  "id": "ns-body",
                  "type": "text",
                  "props": {
                    "text": "{{body}}",
                    "width": "full"
                  }
                },
                {
                  "id": "ns-link",
                  "type": "buttons",
                  "props": {
                    "items": [
                      {
                        "label": "{{linkLabel}}",
                        "url": "{{url}}",
                        "style": "link"
                      }
                    ],
                    "align": "left"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
