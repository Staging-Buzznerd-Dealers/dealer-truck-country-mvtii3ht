  "css": "[data-bz-node=\"utility\"] .bz-navitem > a{font-family:var(--font-body);font-weight:400;font-size:12px;letter-spacing:.04em;text-transform:none;color:#fff}\n[data-bz-node=\"utility\"] .bz-navitem > a:hover{color:#ff8da0}\n[data-bz-node=\"utility\"] .bz-nav{gap:24px}\n[data-bz-node=\"utility-states\"] a{color:#fff;text-decoration:none}\n[data-bz-node=\"utility-states\"] a:hover{color:#ff8da0}\n[data-bz-node=\"utility-states\"] p{margin:0}\n[data-bz-node=\"header\"] .bz-navitem > a{font-family:var(--font-heading);font-weight:500;font-size:14px;letter-spacing:.1em;text-transform:uppercase;color:#14151A;padding-block:0}\n[data-bz-node=\"header\"] .bz-navitem > a:hover{color:#C41230}\n[data-bz-node=\"header\"] .bz-nav{gap:32px}\n[data-bz-node=\"header-logo\"] img{object-fit:contain;width:220px;max-width:60vw;height:auto}\n[data-bz-node=\"header-button\"] .bz-btn{padding:14px 24px;letter-spacing:.1em}\n[data-bz-node=\"header\"] .bz-menu-toggle{width:44px;height:44px;background:#14151A;color:#fff;border:0;border-radius:0;justify-content:center}\n[data-bz-node=\"header\"] .bz-menu-toggle span{width:18px;background:#fff}\n@media (max-width:1100px){\n  [data-bz-node=\"header\"] .bz-menu-wrap[data-open] > .bz-menu{background:#14151A;border-bottom:0;padding:8px 32px 24px}\n  [data-bz-node=\"header\"] .bz-menu-wrap[data-open] .bz-nav{gap:0}\n  [data-bz-node=\"header\"] .bz-menu-wrap[data-open] .bz-navitem{width:100%;border-bottom:1px solid #45474E}\n  [data-bz-node=\"header\"] .bz-menu-wrap[data-open] .bz-navitem > a{display:block;color:#fff;font-size:16px;padding:14px 0}\n  [data-bz-node=\"header\"] .bz-menu-wrap[data-open] .bz-navitem > a:hover{color:#fff}\n}\n[data-bz-node=\"footer-row\"] > .bz-col{grid-column:auto}\n[data-bz-node=\"footer-logo\"] img{width:260px;max-width:100%;height:auto}\n[data-bz-node=\"footer-blurb\"] p{font-size:14px;line-height:1.7;color:#D6D6D8;margin:0;max-width:280px}\n[data-bz-node=\"footer-links\"] .bz-navitem > a{font-family:var(--font-body);font-weight:400;font-size:14px;letter-spacing:0;text-transform:none;color:#D6D6D8}\n[data-bz-node=\"footer-links\"] .bz-navitem > a:hover{color:#fff}\n[data-bz-node=\"footer-links\"] .bz-nav{gap:12px}\n[data-bz-node=\"footer-links-head\"] h2{font-family:var(--font-heading);font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:#fff;margin:0 0 18px}\n[data-bz-node=\"footer-copy\"] p,[data-bz-node=\"footer-credit\"] p{font-size:12px;color:#D6D6D8;margin:0}\n[data-bz-node=\"footer-copy\"] a{color:#D6D6D8}\n[data-bz-node=\"footer-copy\"] a:hover{color:#fff}\n[data-bz-node=\"footer-credit-logo\"] img{width:auto;height:26px}\n[data-bz-section] .tc-social__a,[data-bz-node^=\"footer-social\"] .tc-social__a{width:44px;height:44px}",
