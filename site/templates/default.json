{
  "version": 2,
  "id": "default",
  "name": "Site template",
  "conditions": [
    {
      "type": "entireSite",
      "ref": null
    }
  ],
  "css": "[data-bz-node=\"utility\"] .bz-navitem > a{font-size:12px;letter-spacing:.04em;color:rgba(255,255,255,.75)}\n[data-bz-node=\"utility\"] .bz-navitem > a:hover{color:#fff}\n[data-bz-node=\"utility-states\"] a{color:rgba(255,255,255,.75);text-decoration:none}\n[data-bz-node=\"utility-states\"] a:hover{color:#fff}\n[data-bz-node=\"header\"] .bz-navitem > a{color:#fff}\n[data-bz-node=\"header\"] .bz-navitem > a:hover{color:var(--accent)}\n[data-bz-node=\"header\"] .bz-menu-toggle{color:#fff}\n[data-bz-node=\"header\"] .bz-nav{gap:36px}\n[data-bz-node=\"header-logo\"] img{object-fit:contain}\n@media (max-width:1100px){[data-bz-node=\"header-logo\"] img{height:36px}}\n[data-bz-node=\"footer-blurb\"] p{font-size:14px;line-height:1.7;color:rgba(255,255,255,.65);margin:0}\n[data-bz-node=\"footer-links\"] .bz-navitem > a{font-family:var(--font-body);font-weight:400;font-size:14px;letter-spacing:0;text-transform:none;color:rgba(255,255,255,.65)}\n[data-bz-node=\"footer-links\"] .bz-navitem > a:hover{color:#fff}\n[data-bz-node=\"footer-links-head\"] h2{font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:#fff;margin:0 0 18px}\n[data-bz-node=\"footer-copy\"] p,[data-bz-node=\"footer-credit\"] p{font-size:12px;color:rgba(255,255,255,.65);margin:0}\n[data-bz-node=\"footer-credit\"] img{display:inline-block;width:90px;height:auto;vertical-align:middle;margin-left:8px}",
